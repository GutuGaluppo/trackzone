# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Cloudflare R2 — private bucket, S3-compatible API
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET="trackzone-audio"
# Optional: use the bucket jurisdiction endpoint when required (omit bucket name).
# R2_ENDPOINT="https://your-account-id.eu.r2.cloudflarestorage.com"
# R2_REGION="auto"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Trigger.dev is required for hosted processing in production.
# In development, without this key, `pnpm worker:dev` processes the queue using R2.
# TRIGGER_SECRET_KEY="tr_dev_..."

# Optional — SoundCloud account connection.
# All three must be set together or the integration stays off (Settings shows
# "not configured"). Registering a SoundCloud API app currently requires an
# Artist Pro subscription and is often waitlisted — see
# https://developers.soundcloud.com/docs/api/register-app
# Redirect URI to register: ${NEXT_PUBLIC_SITE_URL}/api/providers/soundcloud/callback
# Generate the key with: openssl rand -base64 32
# SOUNDCLOUD_CLIENT_ID="your-soundcloud-client-id"
# SOUNDCLOUD_CLIENT_SECRET="your-soundcloud-client-secret"
# PROVIDER_CREDENTIALS_KEY="base64-or-hex-32-byte-key"
