# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Cloudflare R2 — private bucket, S3-compatible API
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET="trackzone-audio"
# Optional: override for a local S3-compatible endpoint
# R2_ENDPOINT="http://localhost:9000"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional — Trigger.dev, for background audio-metadata processing.
# Without it, uploads still work but stay in "Queued" until this is set.
# TRIGGER_SECRET_KEY="tr_dev_..."
